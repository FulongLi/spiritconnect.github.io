# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# static-export output must never be committed at the repo root — the site is
# built into out/ by GitHub Actions (see .github/workflows/deploy-main-site.yml)
/_next/
/_not-found*
/__next.*
/404.html
/index.html
/index.txt
/journey*
/presence*
/about*
/branches/
/assets/
/glb/
/draco/
/icon.svg

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# macOS/iCloud duplicate artifacts
* 2.svg
* 2.txt
* 2.html
static 3/

# iCloud duplicate artifacts (broad)
* [0-9].*
* [0-9]/
